@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container my-4" style="max-width: 800px;">
    <h2 class="fw-bold mb-3">🔒 CampusConnect Privacy Policy</h2>
    <hr />
    <p class="fs-6 text-dark">
        CampusConnect is dedicated to protecting the privacy of students and faculty members.
        All information published on the notice board is meant exclusively for campus academic and administrative purposes.
    </p>
    <ul class="list-group list-group-flush mt-3">
        <li class="list-group-item">📌 Student and faculty data is stored securely in-memory during active sessions.</li>
        <li class="list-group-item">📌 Announcements are posted exclusively by authorized campus administration.</li>
        <li class="list-group-item">📌 For any privacy concerns, contact the CampusConnect IT Helpdesk.</li>
    </ul>
</div>