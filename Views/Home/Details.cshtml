@model CampusConnect.Models.Notice

@{
    ViewData["Title"] = "Notice Details";
}

<div class="container my-4" style="max-width: 800px;">
    <div class="mb-3">
        <a asp-action="Index" class="btn btn-outline-dark btn-sm">← Back to Notice Board</a>
    </div>

    <div class="card border-secondary shadow-sm">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">📌 @Model.Title</h4>
            <span>📅 @Model.PostedDate.ToString("dd-MMM-yyyy")</span>
        </div>
        <div class="card-body p-4">
            <div class="mb-3">
                <span class="badge bg-primary fs-6">Category: @Model.Category</span>
                <span class="badge bg-secondary fs-6 ms-2">Target Dept: @Model.TargetDepartment</span>
                <span class="badge bg-info text-dark fs-6 ms-2">Posted By: @Model.PostedBy</span>
            </div>

            <hr />

            <h5 class="fw-bold mb-3">Announcement Details:</h5>
            <p class="fs-5 text-dark" style="white-space: pre-line;">@Model.Description</p>
        </div>
        <div class="card-footer text-muted text-end">
            CampusConnect - Smart College Portal
        </div>
    </div>
</div>