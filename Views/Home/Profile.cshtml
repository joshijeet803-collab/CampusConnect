@{
    ViewData["Title"] = "Admin Profile";
    var user = Context.Request.Cookies["UserName"] ?? "Admin User";
}

<div class="container my-4" style="max-width: 600px;">
    <div class="card shadow-sm border-secondary">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">👤 Profile Overview</h5>
            <a asp-action="Index" class="btn btn-sm btn-outline-light">← Back</a>
        </div>
        <div class="card-body p-4 text-center">
            <h3 class="fw-bold">@user</h3>
            <p class="text-muted">Administrator & Notice Publisher</p>
            <hr />
            <div class="text-start">
                <p><strong>Department:</strong> Campus Administration</p>
                <p><strong>Designation:</strong> Chief Notice Board Coordinator</p>
                <p><strong>Status:</strong> <span class="badge bg-success">Active</span></p>
            </div>
            <a asp-action="Logout" class="btn btn-outline-danger mt-3 px-4">Logout from Portal</a>
        </div>
    </div>
</div>